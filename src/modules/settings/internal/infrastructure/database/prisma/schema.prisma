generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model CostConfig {
  id                    String   @id @default("singleton")
  monthlySalary         Float
  monthlyWorkingHours   Float
  depreciationPerMinute Float
  defaultMarginPercent  Float    @default(0)
  updatedAt             DateTime @updatedAt

  @@map("cost_config")
}
