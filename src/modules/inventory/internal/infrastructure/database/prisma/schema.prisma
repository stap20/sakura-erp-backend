generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                   String   @id
  name                 String   @unique
  description          String?
  referenceBatchGm      Float?
  referenceDurationMin  Float?
  referenceWastePercent Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  items Item[]

  @@map("products")
}

model Item {
  id                       String   @id @default(cuid())
  name                     String   @unique
  type                     String   // RAW_MATERIAL | PACKAGING | FINAL_PRODUCT | SHIPPING_PACKAGING
  measureUnit              String   // KG | G | L | ML | PCS
  currentStock             Decimal  @default(0)
  categoryId               String?
  productId                String?
  status                   String   @default("ACTIVE")
  unitWeightGm             Float?
  weightedAverageUnitPrice Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  category              Category?              @relation(fields: [categoryId], references: [id])
  product               Product?               @relation(fields: [productId], references: [id])
  transactions          InventoryTransaction[]
  packagingComponents   PackagingComponent[]   @relation("VariantPackaging")
  usedAsPackagingIn     PackagingComponent[]   @relation("PackagingItem")
  addonComponents       AddonComponent[]       @relation("VariantAddon")
  usedAsAddonIn         AddonComponent[]       @relation("AddonItem")

  @@map("items")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items Item[]

  @@map("categories")
}

model PackagingComponent {
  id              String @id
  variantItemId   String
  packagingItemId String
  qtyPerUnit      Float

  variantItem   Item @relation("VariantPackaging", fields: [variantItemId], references: [id])
  packagingItem Item @relation("PackagingItem", fields: [packagingItemId], references: [id])

  @@map("packaging_components")
}

model AddonComponent {
  id                 String @id
  variantItemId      String
  ingredientCategory String
  addonItemId        String

  variantItem Item @relation("VariantAddon", fields: [variantItemId], references: [id])
  addonItem   Item @relation("AddonItem", fields: [addonItemId], references: [id])

  @@unique([variantItemId, ingredientCategory])
  @@map("addon_components")
}

model InventoryTransaction {
  id          String   @id @default(cuid())
  itemId      String
  type        String   // RESTOCK | DEDUCT
  quantity    Decimal
  vendorId    String?
  unitPrice   Decimal?
  performedBy String
  notes       String?
  createdAt   DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@map("inventory_transactions")
}
